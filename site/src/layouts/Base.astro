---
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Issue number for the masthead folio line, when the page belongs to one. */
  issueNumber?: number;
  /** ISO date (YYYY-MM-DD) for the masthead dateline. */
  date?: string;
}

const {
  title,
  description = 'Le notizie che i fantallenatori vorrebbero insabbiare.',
  issueNumber,
  date,
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Original mark: an ink-and-red parody seal, not Astro's default logo. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Il Fatto Fantidiano</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Il Fatto Fantidiano`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />

    <!-- Two serif families, loaded here so the design system stays dependency
         free: Bodoni Moda (display) + Source Serif 4 (text). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..600&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <a class="skip-link" href="#main">Salta al contenuto</a>
      <Masthead issueNumber={issueNumber} date={date} />
      <main id="main" class="wrap">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
